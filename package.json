{
  "name": "weniger-songs-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Songs written and song by Dr. Brad Weniger",
  "bugs": {
    "url": "https://github.com/CandeeGenerations/weniger-songs-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:CandeeGenerations/weniger-songs-ui.git"
  },
  "license": "MIT",
  "author": "Candee Generations <admin@candeegenerations.com>",
  "scripts": {
    "build": "fnm use; REACT_APP_VERSION=$npm_package_version GENERATE_SOURCEMAP=false NODE_ENV=production craco build",
    "eject": "react-scripts eject",
    "eslint": "eslint 'src/**/*.{ts,tsx}'",
    "generate": "graphql-codegen --config codegen.yml",
    "preinstall": "npx only-allow pnpm",
    "pcheck": "npm-check -u -i '{antd,@graphql-codegen/*}' && pnpm audit",
    "prepare": "husky",
    "prettier": "prettier --cache --check --write --ignore-unknown .",
    "prettier:ci": "pnpm exec prettier --check .",
    "start": "fnm use; phase run 'REACT_APP_VERSION=$npm_package_version BROWSER=none craco start'"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@apollo/client": "4.3.1",
    "@craco/craco": "^7.1.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "antd": "^5.29.3",
    "copy-text-to-clipboard": "^3.2.2",
    "craco-webpack-resolve": "^1.2.1",
    "dayjs": "1.11.23",
    "graphql": "^16.14.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-scripts": "^5.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/introspection": "^5.0.2",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@graphql-codegen/typescript-react-apollo": "^4.4.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "react-app-alias": "^2.2.2",
    "sort-package-json": "^4.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "proxy": "http://localhost:5502"
}
